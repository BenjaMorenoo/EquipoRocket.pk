# .env — Variables para docker-compose
# Copia como .env en la raíz del monorepo

DB_PASSWORD=cambia_este_password

# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=genera_un_secreto_de_64_bytes_aqui
JWT_REFRESH_SECRET=genera_otro_secreto_diferente_aqui

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173
INTERNAL_SERVICE_KEY=clave_interna_entre_microservicios
